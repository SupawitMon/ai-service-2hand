    },
    {
      "key": "last_request_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. AI ประเมินราคา",
      "description": "ทายเกรดจากรูป (YOLO) + ประเมินราคา (XGBoost)",
      "item": [
        {
          "name": "รายชื่อยี่ห้อ/รุ่น",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/options",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "options"
              ]
            },
            "description": "ใช้ทำ dropdown ยี่ห้อ/รุ่น — `brands` (list) และ `brand_models` ({ยี่ห้อ: [รุ่น]})"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"มีรายชื่อยี่ห้อ\", () => pm.expect(pm.response.json().brands.length).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "ทายเกรดจากรูป",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/predict-grade",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "predict-grade"
              ]
            },
            "description": "**ต้องเลือกไฟล์รูปเองก่อนกด Send** (Body → form-data → key `image`)\n\nได้ `grade` (A/B/C) และ `confidence`",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "เลือกไฟล์รูปสินค้า (jpg/png) ในแท็บ Body"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const img = pm.request.body && pm.request.body.formdata && pm.request.body.formdata.get(\"image\");",
                  "if (!img || !img.src || (pm.response.code === 400 && /image|รูป/i.test(pm.response.text()))) {",
                  "  pm.test.skip(\"ยังไม่ได้เลือกไฟล์รูป (Body → form-data → image) — ข้ามการทดสอบนี้\", () => {});",
                  "} else {",
                  "  pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "  pm.test(\"ได้เกรด A/B/C\", () => pm.expect([\"A\",\"B\",\"C\"]).to.include(pm.response.json().grade));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "ประเมินราคา",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/predict-price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "predict-price"
              ]
            },
            "description": "`grade`: A / B / C · `accessories`: full / partial / none · `year` ไม่บังคับ\n\nได้ช่วงราคา (`recommended_min`, `recommended_max`), ราคาแนะนำ `expected_price` และ `factors` ปัจจัยที่มีผลต่อราคา (บาท +/−)",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Apple\",\n  \"model\": \"iPhone 13\",\n  \"grade\": \"B\",\n  \"accessories\": \"full\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"มีช่วงราคา + ปัจจัย\", () => { const j = pm.response.json(); pm.expect(j.factors).to.be.an(\"array\"); pm.expect(j.recommended_max).to.be.at.least(j.recommended_min); pm.expect(j.expected_price).to.be.within(j.recommended_min, j.recommended_max); });"
                ]
              }
            }
          ]
        },
        {
          "name": "ประเมินราคา — พิมพ์ชื่อรุ่นไม่ครบ (ได้รุ่นใกล้เคียง)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/predict-price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "predict-price"
              ]
            },
            "description": "ตัวอย่าง error 404: ระบบตอบ `suggestions` รุ่นที่ใกล้เคียงกลับมา",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"brand\": \"Apple\",\n  \"model\": \"iphone\",\n  \"grade\": \"B\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 + suggestions\", () => { pm.response.to.have.status(404); pm.expect(pm.response.json().suggestions.length).to.be.above(0); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
